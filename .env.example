LLM_BASE_URL=https://your-endpoint-here
LLM_API_VERSION=2024-12-01-preview
LLM_API_KEY=your-api-key-here

DEPLOYMENT_GPT41=gpt-4.1
DEPLOYMENT_GPT41_MINI=gpt-4.1-mini
DEPLOYMENT_GPT4O=gpt-4o
DEPLOYMENT_GPT4O_MINI=gpt-4o-mini
DEPLOYMENT_GPT5=gpt-5
DEPLOYMENT_GPT5_MINI=gpt-5-mini
DEPLOYMENT_GPT54=gpt-5.4
DEPLOYMENT_EMBED_LARGE=text-embedding-3-large
DEPLOYMENT_EMBED_SMALL=text-embedding-3-small
DEPLOYMENT_EMBED_ADA=text-embedding-ada-002

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls_...
LANGSMITH_PROJECT=schemascout

# Episodic Memory(confirmed_mapping_examples) 캐시 만료 기준(일) - LRU 방식.
# 마지막으로 검색에 실제로 쓰인 시점(last_accessed_at) 기준으로 이 기간이 지나면
# 후보에서 제외된다. 생략 시 기본값 180일.
EPISODIC_MEMORY_TTL_DAYS=180